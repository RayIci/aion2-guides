---
import type { PatchView } from '../content-core';
import { GuideList, type GuideListEntry } from '@/components/site/guide-list';
import { guidesIn } from '../lib/nav';
import { guideTitle, guideEntry } from '../lib/guides';
import { withBase } from '../lib/url';

interface Props {
  patch: PatchView;
  prefixed: boolean;
}

const { patch, prefixed } = Astro.props;
const guides: GuideListEntry[] = guidesIn(patch.sections).map((g) => {
  const row = patch.coverage.find((c) => c.guide === g);
  return {
    id: g,
    title: guideTitle(patch, g),
    href: withBase(prefixed ? `/${patch.meta.id}/${guideEntry(patch, g)}` : `/${guideEntry(patch, g)}`),
    sections: row?.sections,
    drafts: row?.drafts,
    claims: row?.claims,
  };
});
---
<GuideList guides={guides} />
