---
import { CalendarClockIcon, HistoryIcon } from 'lucide-react';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import type { PatchView } from '../content-core';

interface Props {
  patch: PatchView;
  /** Same page in the default (live) patch, if this isn't it. */
  liveHref?: string;
}

const { patch, liveHref } = Astro.props;
---
{
  patch.meta.status === 'staged' ? (
    <Alert className="mb-8">
      <CalendarClockIcon />
      <AlertTitle>Not released on Global yet</AlertTitle>
      <AlertDescription>
        This is a staged patch, prepared from announced or KR/TW patch notes. It can change before it reaches Global.
        {liveHref && (
          <a class="underline underline-offset-4" href={liveHref}>
            Open the live version
          </a>
        )}
      </AlertDescription>
    </Alert>
  ) : patch.meta.status === 'superseded' ? (
    <Alert className="mb-8">
      <HistoryIcon />
      <AlertTitle>You're reading an older patch</AlertTitle>
      <AlertDescription>
        This page describes the game as of {patch.meta.title}.
        {liveHref && (
          <a class="underline underline-offset-4" href={liveHref}>
            Open the live version
          </a>
        )}
      </AlertDescription>
    </Alert>
  ) : null
}
