---
import type { Source } from '../content-core';
import { Badge } from '@/components/ui/badge';

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
const TYPE = { official: 'Official', data: 'Data', creator: 'Creator', community: 'Community' } as const;
---
{
  sources.length > 0 && (
    <section aria-labelledby="sources-heading" class="mt-16 flex flex-col gap-4 bg-muted p-6">
      <h2 id="sources-heading" class="font-heading text-xl font-bold">Sources</h2>
      <ol class="flex flex-col gap-3 text-base">
        {sources.map((s, i) => (
          <li id={`src-${i + 1}`} class="flex gap-3 rounded-md target:bg-muted">
            <span class="w-5 shrink-0 text-right text-muted-foreground tabular-nums">{i + 1}.</span>
            <div class="flex min-w-0 flex-col gap-1">
              <a href={s.url} rel="noopener" target="_blank" class="font-medium underline-offset-4 hover:underline">
                {s.title}
              </a>
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-muted-foreground">
                <Badge variant="outline">{TYPE[s.type]}</Badge>
                <span>{s.region.toUpperCase()}</span>
                {s.author && <span>{s.author}</span>}
                {s.about_patch && <span>about {s.about_patch}</span>}
                <span>accessed {s.accessed}</span>
                {s.archived_url && (
                  <a href={s.archived_url} rel="noopener" target="_blank" class="underline underline-offset-4 hover:text-foreground">
                    archived copy
                  </a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}
