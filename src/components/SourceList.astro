---
import type { Source } from '../content-core';

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
const TYPE = { official: 'Official', data: 'Data', creator: 'Creator', community: 'Community' } as const;
---
{
  sources.length > 0 && (
    <section class="sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">Sources</h2>
      <ol>
        {sources.map((s, i) => (
          <li id={`src-${i + 1}`}>
            <a href={s.url} rel="noopener" target="_blank">{s.title}</a>
            {s.author && <span> · {s.author}</span>}
            <span class="source-meta">
              {' '}· {TYPE[s.type]} · {s.region.toUpperCase()}
              {s.about_patch && <> · about {s.about_patch}</>} · accessed {s.accessed}
            </span>
            {s.archived_url && (
              <>
                {' '}· <a href={s.archived_url} rel="noopener" target="_blank">archived</a>
              </>
            )}
          </li>
        ))}
      </ol>
    </section>
  )
}
