---
import { label, type NavNode } from '../lib/nav';
import { sectionPath } from '../lib/content';
import { withBase } from '../lib/url';

interface Props {
  node: NavNode;
  patchId: string;
  currentId: string;
}

const { node, patchId, currentId } = Astro.props;
const href = (id: string) => withBase(`/${patchId}/${sectionPath(id)}`);
---
<ul>
  {
    node.children.map((child) => (
      <li>
        {child.section ? (
          <a href={href(child.section.id)} aria-current={child.section.id === currentId ? 'page' : undefined}>
            {label(child)}
            {child.section.changedHere && <span class="nav-changed" title="Changed in this patch">●</span>}
          </a>
        ) : (
          <span class="nav-folder">{label(child)}</span>
        )}
        {child.children.length > 0 && <Astro.self node={child} patchId={patchId} currentId={currentId} />}
      </li>
    ))
  }
</ul>
