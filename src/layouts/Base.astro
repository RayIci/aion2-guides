---
import '../styles/global.css';
import { HeaderControls, type PatchNav } from '@/components/site/site-header';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Pages with their own shell (guide pages) skip the simple site header. */
  bare?: boolean;
  /** Patch switcher and changelog link for the header. */
  patch?: PatchNav;
}

const { title, description = 'Patch-versioned, source-cited AION 2 guides for Global / NA-EU.', bare = false, patch } = Astro.props;
const fullTitle = title === 'AION 2 Guides' ? title : `${title} · AION 2 Guides`;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <script is:inline>
      // Apply the saved theme before first paint. Dark is the default; same rule as ModeToggle.
      try {
        const t = localStorage.getItem('theme');
        const dark = t === 'light' ? false : t === 'system' ? matchMedia('(prefers-color-scheme: dark)').matches : true;
        document.documentElement.classList.toggle('dark', dark);
      } catch {}
    </script>
  </head>
  <body class="min-h-svh">
    {
      bare ? (
        <slot />
      ) : (
        <>
          <header class="sticky top-0 z-10 flex h-14 items-center gap-4 border-b bg-background px-4 md:px-8">
            <a class="font-semibold" href={withBase('/')}>AION 2 Guides</a>
            <HeaderControls client:load patch={patch} />
          </header>
          <main class="mx-auto w-full max-w-3xl px-4 py-10 md:px-8">
            <slot />
          </main>
          <footer class="mx-auto w-full max-w-3xl px-4 pb-10 text-sm text-muted-foreground md:px-8">
            Fan-made guide for AION 2 (Global / NA-EU). Not affiliated with NCSOFT. Every claim links to its source.
          </footer>
        </>
      )
    }
  </body>
</html>
