---
import Base from './Base.astro';
import { GuideShell, type Crumb } from '@/components/site/guide-shell';
import type { NavItemData } from '../lib/nav';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  guideTitle: string;
  patchLabel: string;
  items: NavItemData[];
  crumbs: Crumb[];
}

const { title, guideTitle, patchLabel, items, crumbs } = Astro.props;
---
<Base title={`${title} · ${guideTitle}`} bare>
  <GuideShell client:load siteHref={withBase('/')} guideTitle={guideTitle} patchLabel={patchLabel} items={items} crumbs={crumbs}>
    <slot />
  </GuideShell>
</Base>
