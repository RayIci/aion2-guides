---
import type { GetStaticPaths } from 'astro';
import { InfoIcon } from 'lucide-react';
import Base from '../layouts/Base.astro';
import Guide from '../layouts/Guide.astro';
import GuideList from '../components/GuideList.astro';
import SourceList from '../components/SourceList.astro';
import PatchNotice from '../components/PatchNotice.astro';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { Badge } from '@/components/ui/badge';
import type { PatchView, ResolvedSection } from '../content-core';
import { guideOf, iconFor } from '../content-core';
import { getContent, sectionPath } from '../lib/content';
import { guideEntry, guideTitle } from '../lib/guides';
import { buildNav, label, toNavItems, type NavNode } from '../lib/nav';
import { patchNav, patchTargets } from '../lib/patches';
import { withBase } from '../lib/url';

type Props = { patch: PatchView; section?: ResolvedSection; prefixed: boolean };

export const getStaticPaths = (async () => {
  const content = await getContent();
  const paths: { params: { path: string }; props: Props }[] = [];
  for (const patch of content.patches) {
    paths.push({ params: { path: patch.meta.id }, props: { patch, prefixed: true } });
    for (const section of patch.sections) {
      paths.push({ params: { path: `${patch.meta.id}/${sectionPath(section.id)}` }, props: { patch, section, prefixed: true } });
      if (patch === content.defaultPatch) {
        paths.push({ params: { path: sectionPath(section.id) }, props: { patch, section, prefixed: false } });
      }
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { patch, section, prefixed } = Astro.props;
const content = await getContent();
const headerPatch = patchNav(content, patch, section?.id, withBase);
const live = content.defaultPatch;
const liveTarget = live && live !== patch ? patchTargets(content, section?.id).find((t) => t.id === live.meta.id) : undefined;
const liveHref = liveTarget && withBase(liveTarget.href);
const CONFIDENCE = { verified: 'Verified', community: 'Community', unverified: 'Unverified' } as const;
const STATUS = {
  draft: { label: 'Draft', variant: 'outline' },
  researched: { label: 'Researched', variant: 'secondary' },
  reviewed: { label: 'Reviewed', variant: 'default' },
} as const;
const PATCH_STATUS = { staged: 'Staged, not released on Global yet', live: 'Live', superseded: 'Superseded' } as const;

const href = (id: string) => withBase(`/${patch.meta.id}/${sectionPath(id)}`);

// One confidence line per page, since inline badges are hidden by default.
// Skill and item pages show the game icon next to their title.
const titleIcon = section
  ? iconFor({ media: content.media, assetBase: '', className: section.id.startsWith('classes/') ? section.id.split('/')[1] : undefined }, section.title)
  : undefined;
const claimCount = section?.claims.length ?? 0;
const verifiedShare = claimCount ? Math.round((100 * (section?.claims.filter((c) => c.confidence === 'verified').length ?? 0)) / claimCount) : 0;
const pageConfidence = !claimCount ? undefined : verifiedShare >= 80 ? 'verified' : verifiedShare >= 40 ? 'community' : 'unverified';

let guideView: { title: string; items: ReturnType<typeof toNavItems>; crumbs: { title: string; href?: string }[] } | undefined;
if (section) {
  const guide = guideOf(section.id);
  const nav = buildNav(patch.sections, guide);
  const title = guideTitle(patch, guide);
  // Breadcrumbs: guide, then each folder on the way down (linked when it has an index page), then the section.
  const crumbs: { title: string; href?: string }[] = [{ title, href: withBase(`/${patch.meta.id}/${guideEntry(patch, guide)}`) }];
  let node: NavNode | undefined = nav;
  const parts = section.id.slice(guide.length + 1).split('/').filter((p) => p && p !== 'index');
  for (const part of parts) {
    node = node?.children.find((c) => c.name === part);
    if (!node) break;
    crumbs.push({ title: label(node), href: node.section ? href(node.section.id) : undefined });
  }
  guideView = { title, items: toNavItems(nav, href, section.id), crumbs };
}
---
{
  section && guideView ? (
    <Guide
      title={section.title}
      guideTitle={guideView.title}
      patchLabel={`Patch ${patch.meta.id}`}
      items={guideView.items}
      crumbs={guideView.crumbs}
      patch={headerPatch}
      playHref={withBase(`/${patch.meta.id}/play/${guideOf(section.id)}`)}
    >
      <PatchNotice patch={patch} liveHref={liveHref} />
      {/* Search index (Pagefind): only the patch-prefixed copy of each section, filterable by patch. */}
      <div
        data-pagefind-body={prefixed ? '' : undefined}
      >
      {/* Values come from attributes (`key[attr]`) so no text enters the index. */}
      <span hidden data-pagefind-filter="patch[data-value]" data-value={patch.meta.id}></span>
      <span hidden data-pagefind-meta="patch[data-value]" data-value={patch.meta.title}></span>
      <span hidden data-pagefind-meta="guide[data-value]" data-value={guideView.title}></span>
      <header class="flex flex-col gap-3">
        <h1 class="flex items-center gap-3 text-3xl font-semibold tracking-tight text-balance">
          {titleIcon && <img class="size-12 shrink-0 rounded-md bg-muted object-contain" src={withBase(`img/icons/${titleIcon}.webp`)} alt="" width="48" height="48" />}
          <span data-pagefind-meta="title">{section.title}</span>
        </h1>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground" data-pagefind-ignore>
          <Badge variant={STATUS[section.status].variant}>{STATUS[section.status].label}</Badge>
          <span>
            {section.changedHere
              ? patch.meta.parent
                ? `Changed in patch ${patch.meta.id}`
                : `Written for patch ${patch.meta.id}`
              : `Unchanged since patch ${section.originPatch}`}
          </span>
          {section.lastChecked && <span>Last checked {section.lastChecked}</span>}
        </div>
        {pageConfidence && (
          <p class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground" data-pagefind-ignore>
            <Badge variant={pageConfidence}>{verifiedShare}% verified</Badge>
            <span>{claimCount} cited claims. Turn on Sources in the header to see each one.</span>
          </p>
        )}
        {section.sectionConfidence && (
          <p class="flex items-center gap-2 text-sm text-muted-foreground" data-pagefind-ignore>
            Section sources
            <Badge variant={section.sectionConfidence}>{CONFIDENCE[section.sectionConfidence]}</Badge>
          </p>
        )}
      </header>
      {section.status === 'draft' && (
        <Alert className="mt-6" data-pagefind-ignore>
          <InfoIcon />
          <AlertTitle>Draft</AlertTitle>
          <AlertDescription>This section hasn't been researched yet. Treat it as a placeholder.</AlertDescription>
        </Alert>
      )}
      <div class="prose prose-neutral mt-6 max-w-none dark:prose-invert" data-section-id={section.id} set:html={section.html} />
      </div>
      <div data-pagefind-ignore>
        <SourceList sources={section.sources} />
        <p class="mt-10 text-sm text-muted-foreground">Game icons and maps © NCSOFT, taken from the game data via gaming.tools.</p>
      </div>
    </Guide>
  ) : (
    <Base title={patch.meta.title} patch={headerPatch}>
      <PatchNotice patch={patch} liveHref={liveHref} />
      <div class="flex flex-col gap-2">
        <h1 class="text-3xl font-semibold tracking-tight text-balance">{patch.meta.title}</h1>
        <p class="flex flex-wrap gap-x-3 text-sm text-muted-foreground">
          <span>{PATCH_STATUS[patch.meta.status]}</span>
          {patch.meta.released && <span>Released {patch.meta.released}</span>}
          <a class="underline underline-offset-4 hover:text-foreground" href={withBase(`/${patch.meta.id}/changelog`)}>
            Changelog
          </a>
          <a class="underline underline-offset-4 hover:text-foreground" href={withBase(`/${patch.meta.id}/coverage`)}>
            Source coverage
          </a>
        </p>
      </div>
      {patch.overview && <div class="prose prose-neutral mt-6 max-w-none dark:prose-invert" set:html={patch.overviewHtml} />}
      <h2 class="mt-10 mb-4 text-lg font-semibold">Guides</h2>
      <GuideList patch={patch} prefixed />
      <SourceList sources={patch.overviewSources} />
    </Base>
  )
}
