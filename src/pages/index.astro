---
import Base from '../layouts/Base.astro';
import GuideList from '../components/GuideList.astro';
import { getContent } from '../lib/content';
import { patchNav } from '../lib/patches';
import { withBase } from '../lib/url';

const content = await getContent();
const patch = content.defaultPatch;
---
<Base title="AION 2 Guides" patch={patch && patchNav(content, patch, undefined, withBase)}>
  <h1 class="text-3xl font-semibold tracking-tight">AION 2 Guides</h1>
  <p class="mt-3 text-muted-foreground">
    Class and farming guides for AION 2 on the Global (NA/EU) servers. Every claim links to its source, and every patch has a changelog of
    what changed in the guides.
  </p>

  {
    patch ? (
      <section class="mt-10">
        <h2 class="text-lg font-semibold">Live patch</h2>
        <p class="mt-2">
          {patch.meta.title}
          {patch.meta.released && <span class="text-muted-foreground"> · released {patch.meta.released}</span>}
        </p>
        <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
          <li><a class="underline underline-offset-4" href={withBase(`/${patch.meta.id}/changelog`)}>What changed</a></li>
          <li><a class="underline underline-offset-4" href={withBase(`/${patch.meta.id}/coverage`)}>Source coverage</a></li>
          <li><a class="underline underline-offset-4" href={withBase('/patches')}>All patches</a></li>
          <li><a class="underline underline-offset-4" href={withBase('/compare')}>Compare patches</a></li>
        </ul>
      </section>
    ) : (
      <p class="mt-10 text-muted-foreground">No patch documented yet.</p>
    )
  }

  <section class="mt-10">
    <h2 class="text-lg font-semibold">Guides</h2>
    <div class="mt-3">
      {patch ? <GuideList patch={patch} prefixed={false} /> : null}
    </div>
    <ul class="mt-4 list-disc pl-5 text-muted-foreground">
      <li>Gladiator and Assassin: being written now.</li>
      <li>The other six classes: after those two.</li>
      <li>Farming, gathering, crafting and economy: after the class guides.</li>
    </ul>
  </section>
</Base>
