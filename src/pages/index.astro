---
import Base from '../layouts/Base.astro';
import { ModeToggle } from '@/components/site/mode-toggle';
import { SearchDialog } from '@/components/site/search-dialog';
import { deriveConfidence } from '../content-core/confidence';
import type { Confidence, Source } from '../content-core';
import { getContent } from '../lib/content';
import { guideEntry } from '../lib/guides';
import { withBase } from '../lib/url';
import { CLAIMS, CLASSES, PATCH_SHEETS, WEAPON_SOURCE } from '../data/home';
import credits from '../../public/images/credits.json';

const content = await getContent();
const patch = content.defaultPatch;
const sources = content.sources;
const img = (file: string) => withBase(`/images/${file}`);

const GRADE: Record<Confidence, string> = { verified: 'Verified', community: 'Community', unverified: 'Unverified' };
const WHY: Record<Confidence, string> = {
  verified: 'An official or datamined Global source backs it, or two independent sources agree.',
  community: 'Only one non-official source backs it, or only KR/TW sources. Treat it as likely, not certain.',
  unverified: 'No source yet. It stays marked until one is found.',
};
const grade = (ids: string[]) => deriveConfidence({ sourceIds: ids, caps: [], opinion: false }, sources);
const known = (ids: string[]) => ids.filter((id) => sources.has(id));
const slips = CLAIMS.filter((c) => known(c.sources).length === c.sources.length && (!c.against || known(c.against.sources).length)).map((c) => ({
  ...c,
  grade: grade(c.sources),
  cited: c.sources.map((id) => sources.get(id)!) as Source[],
  againstGrade: c.against && grade(c.against.sources),
  againstCited: c.against?.sources.map((id) => sources.get(id)!) as Source[] | undefined,
}));

// The source names we really cite, printed like a programme's list of patrons.
const patronOf = (s: Source) => (s.type === 'official' ? `${s.author ?? 'NCSOFT'} ${s.region === 'global' ? 'Global' : s.region.toUpperCase()}` : (s.author ?? s.title));
const patronCounts = new Map<string, number>();
for (const s of sources.values()) patronCounts.set(patronOf(s), (patronCounts.get(patronOf(s)) ?? 0) + 1);
const patrons = [...patronCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const archived = [...sources.values()].filter((s) => s.archived_url).length;

const sheet = patch && PATCH_SHEETS[patch.meta.id];
const weaponSource = sources.get(WEAPON_SOURCE);
const guidePath = (name: string) => {
  const g = `classes/${name.toLowerCase()}`;
  const entry = patch && guideEntry(patch, g);
  return entry ? withBase(`/${entry}`) : undefined;
};
const changelogHref = patch ? withBase(`/${patch.meta.id}/changelog`) : withBase('/patches');
const fmt = (d?: string) => (d ? new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
const creditLine = (credits as { title: string; credit: string; page: string; file: string }[]).map((c) => ({ text: c.credit.replace(/ title QS:.*?(?=" by)/, ''), page: c.page }));
---
<Base title="AION 2 Guides" bare>
  <div class="home">
    <!-- Hero: the binder. Wordmark centred, the edition's folders stacked below. -->
    <header class="hero">
      <nav class="toprow" aria-label="Site">
        <div class="toprow-left" data-ui>
          {patch && <SearchDialog client:load patchId={patch.meta.id} patchTitle={patch.meta.title} />}
          <ModeToggle client:load />
        </div>
        <a class="wordmark" href={withBase('/')}>AION 2 Guides</a>
        <div class="toprow-right">
          <a href={withBase('/patches')}>Patches</a>
          {patch && <a href={withBase(`/${patch.meta.id}/coverage`)}>Coverage</a>}
        </div>
      </nav>
      <h1 class="title">AION 2 Guides</h1>
      <p class="sub">Class and farming guides for AION 2 on the Global servers. Every claim names its source, and every patch says what changed.</p>

      <div class="folders">
        <a class="folder f1" href="#patch"><span class="tab">Patch notes</span></a>
        <a class="folder f2" href="#grades"><span class="tab">How a claim is graded</span></a>
        <a class="folder f3" href="#sources"><span class="tab">Where claims come from</span></a>
        <a class="folder f4" href="#classes"><span class="tab">Classes</span></a>
        <section class="folder front" aria-label="Live patch">
          <span class="tab">Live patch</span>
          <div class="front-body">
            <div class="front-text">
            <a class="action" href={changelogHref}>Read what this patch changed</a>
            {
              patch ? (
                <p class="edition">
                  <span class="edition-name">{patch.meta.title}</span>
                  <span>Released {fmt(patch.meta.released)} · {content.sources.size} sources on file, {archived} archived</span>
                </p>
              ) : (
                <p class="edition">No patch documented yet.</p>
              )
            }
            </div>
            <ol class="plate" aria-label="The eight classes and their weapons">
              {CLASSES.map((c, i) => (
                <li data-enter style={`--d:${200 + i * 60}ms`}>
                  <a href="#classes" title={`${c.name}: ${c.weapon}`}>
                    <img src={img(c.image)} alt={`${c.picture}, standing in for the ${c.name}'s ${c.weapon.toLowerCase()}`} width="200" height="400" decoding="async" />
                    <span>{c.name}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>
      </div>
    </header>

    <!-- Classes: the giant word over the eight class rows; pointing at a row shows its weapon. -->
    <section id="classes" class="classes" data-preview-root>
      <div class="classes-col">
        <h2 class="giant" data-enter>Classes</h2>
        <p class="lede" data-enter style="--d:80ms">Eight classes on Global. Gladiator and Assassin are being written first; the rest follow.</p>
        <div class="bars" data-enter style="--d:160ms">
          {
            CLASSES.map((c, i) => (
              <details class="bar" open={i === 0} data-preview={img(c.image)} data-preview-alt={c.picture}>
                <summary>
                  <span class="bar-name">{c.name}</span>
                  <span class="bar-weapon">{c.weapon}</span>
                  <span class="bar-plus" aria-hidden="true" />
                </summary>
                <div class="bar-panel">
                  <img class="bar-img" src={img(c.image)} alt={c.picture} width="480" height="640" loading="lazy" decoding="async" />
                  <dl>
                    <div><dt>Weapon</dt><dd>{c.weapon}{weaponSource && <> · <a href={weaponSource.url} rel="noopener" target="_blank">official skins notice</a></>}</dd></div>
                    <div>
                      <dt>Guide</dt>
                      <dd>
                        {c.status === 'writing'
                          ? guidePath(c.name)
                            ? <a href={guidePath(c.name)}>Open the {c.name} guide</a>
                            : 'Being written now'
                          : 'After Gladiator and Assassin'}
                      </dd>
                    </div>
                    <div><dt>Pictured</dt><dd>{c.picture}. A museum piece of the same weapon type, not game art.</dd></div>
                  </dl>
                </div>
              </details>
            ))
          }
        </div>
      </div>
      <figure class="preview" aria-hidden="true">
        <img src={img(CLASSES[0].image)} alt="" width="480" height="640" data-preview-img />
        <figcaption data-preview-caption>{CLASSES[0].picture}</figcaption>
      </figure>
    </section>

    <!-- Sources: printed like a programme's list of patrons. -->
    <section id="sources" class="sources-band">
      <div class="card" data-enter>
        <h2>Where every claim comes from</h2>
        <img class="tipped" src={img('the-lost-angel-then-opened-black-wings.jpg')} alt="Odilon Redon's lithograph of a pale angel spreading black wings" width="1200" height="675" loading="lazy" decoding="async" />
        <p class="names">{patrons.map(([n, count], i) => <>{i > 0 && <span class="dot"> · </span>}<span class="nowrap">{n} <span class="count">{count}</span></span></>)}</p>
        <p class="card-note">{content.sources.size} sources on file. {archived} have an archived copy, so the claims can still be checked if a post disappears.</p>
      </div>
    </section>

    <!-- The live thing: real claims printed as slips; turn one over to read why it has its grade. -->
    <section id="grades" class="grades">
      <img class="grades-bg" src={img('fall-of-the-rebel-angels.jpg')} alt="Pieter Brueghel the Elder, The Fall of the Rebel Angels (1562): winged armies clashing across the sky" width="2400" height="1733" loading="lazy" decoding="async" />
      <div class="grades-text" data-enter>
        <p><strong>Graded, not guessed.</strong> Each claim's grade is worked out from its sources.</p>
        <p>Where sources disagree, both stay on the page. Turn a slip over to see why.</p>
      </div>
      <div class="slips">
        {
          slips.map((s, i) => (
            <details class:list={['slip', s.against ? 'is-conflict' : `is-${s.grade}`]} data-enter style={`--d:${i * 70}ms`}>
              <summary>
                <span class="slip-grade">{s.against ? 'Sources disagree' : GRADE[s.grade]}</span>
                <span class="slip-rule" aria-hidden="true">- - - - - - - - - - - -</span>
                <span class="slip-claim">{s.claim}</span>
                {s.against && <span class="slip-claim">{s.against.claim}</span>}
                <span class="slip-turn">Turn over</span>
              </summary>
              <div class="slip-back">
                {s.against ? (
                  <>
                    <p><strong>{GRADE[s.grade]}:</strong> {s.claim} {WHY[s.grade]}</p>
                    <p><strong>{GRADE[s.againstGrade!]}:</strong> {s.against.claim}</p>
                    <p>The guide shows both until a stronger source settles it.</p>
                  </>
                ) : (
                  <p>{WHY[s.grade]}</p>
                )}
                <ul>
                  {[...s.cited, ...(s.againstCited ?? [])].map((src) => (
                    <li><a href={src.url} rel="noopener" target="_blank">{src.title}</a></li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <!-- Farming & crafting: what comes after the classes, with the oldest blacksmith on film. -->
    <section id="crafting" class="crafting">
      <figure class="clip" data-enter>
        <video autoplay muted loop playsinline preload="metadata" poster={img('blacksmith-scene-1893-poster.jpg')} width="640" height="480" aria-hidden="true">
          <source src={img('blacksmith-scene-1893.webm')} type="video/webm" />
        </video>
        <figcaption>Blacksmith Scene, Edison Studios, 1893.</figcaption>
      </figure>
      <div class="crafting-text">
        <h2 data-enter>Farming and crafting</h2>
        <p data-enter style="--d:80ms">After the classes come the materials: where each one drops or grows, the best spot and an alternative for when it's busy, and a route to farm it.</p>
        <p data-enter style="--d:160ms">Then the professions: Blacksmithing, Armorsmithing, Handicrafting, Alchemy and Cooking, and the six kinds of gathering, each with a levelling path and what's worth making this patch.</p>
      </div>
    </section>

    <!-- Patch notes: the edition's changes as one printed sheet. -->
    <section id="patch" class="patch-band">
      {
        patch && sheet ? (
          <article class="sheet">
            <h2 data-enter>{patch.meta.title}</h2>
            <p class="sheet-note">The guide-relevant lines from NCSOFT's notes, released {fmt(patch.meta.released)}.</p>
            {sheet.groups.map((g, i) => (
              <div class="group" data-enter style={`--d:${i * 60}ms`}>
                <h3>{g.name}</h3>
                <ul>
                  {g.items.map((it) => (
                    <li>
                      <span>{it.what}</span>
                      {it.note && <small>{it.note}</small>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <p class="sheet-close">{sheet.until}<br /><a href={changelogHref}>The guide's changelog for this patch</a></p>
          </article>
        ) : patch ? (
          <article class="sheet">
            <h2>{patch.meta.title}</h2>
            <div class="sheet-overview" set:html={patch.overviewHtml} />
            <p class="sheet-close"><a href={changelogHref}>The guide's changelog for this patch</a></p>
          </article>
        ) : null
      }
    </section>

    <!-- Footer: the back of the card. -->
    <footer class="back">
      <div class="back-card" data-enter>
        <div class="back-msg">
          <p class="signoff">See you in Atreia.</p>
          <p>A fan-made guide, not affiliated with NCSOFT, and it hosts no game art. The pictures are museum works in the public domain.</p>
          <p>Spotted something wrong? Every page lists its sources, so you can check the claim and tell us.</p>
        </div>
        <div class="back-addr">
          <img class="stamp" src={img('archangel-gabriel.jpg')} alt="Martin Schongauer's engraving of the Archangel Gabriel" width="88" height="122" loading="lazy" decoding="async" />
          <a href="https://github.com/RayIci/aion2-guides" rel="noopener" target="_blank">Source on GitHub</a>
          <a href={withBase('/patches')}>Every patch</a>
          {patch && <a href={withBase(`/${patch.meta.id}/coverage`)}>Source coverage</a>}
          <a href={withBase('/compare')}>Compare patches</a>
        </div>
        <p class="imprint">
          Pictures: {creditLine.map((c, i) => <>{i > 0 && ' · '}<a href={c.page} rel="noopener" target="_blank">{c.text}</a></>)}
        </p>
      </div>
    </footer>
  </div>
</Base>

<script>
  // Index with preview: pointing at a class row shows its weapon in the fixed frame (desktop).
  const root = document.querySelector<HTMLElement>('[data-preview-root]');
  const frame = root?.querySelector<HTMLImageElement>('[data-preview-img]');
  const caption = root?.querySelector<HTMLElement>('[data-preview-caption]');
  root?.querySelectorAll<HTMLDetailsElement>('details[data-preview]').forEach((row) => {
    const show = () => {
      if (!frame || frame.getAttribute('src') === row.dataset.preview) return;
      frame.classList.add('is-swapping');
      window.setTimeout(() => {
        frame.src = row.dataset.preview!;
        if (caption) caption.textContent = row.dataset.previewAlt ?? '';
        frame.classList.remove('is-swapping');
      }, 120);
      root.querySelectorAll('details[data-preview]').forEach((r) => r.classList.toggle('is-dim', r !== row));
    };
    row.addEventListener('pointerenter', show);
    row.addEventListener('focusin', show);
    row.addEventListener('toggle', () => row.open && show());
  });
  root?.addEventListener('pointerleave', () => root.querySelectorAll('.is-dim').forEach((r) => r.classList.remove('is-dim')));

  // Section entrances: heading, then text, then picture, once, as each section enters.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // A silent loop is decoration: with reduced motion it stays on its poster frame.
  if (reduce) document.querySelectorAll<HTMLVideoElement>('.home video').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { threshold: 0.15 },
    );
    document.querySelectorAll('.home [data-enter]').forEach((el) => {
      el.classList.add('will-enter');
      io.observe(el);
    });
  }
</script>

<style>
  .home {
    --paper: oklch(0.93 0.006 90);
    --t-s: 14px;
    --t-b: 17px;
    --t-l: 21px;
    --t-h: 30px;
    --paper-ink: oklch(0.2 0.005 270);
    --paper-soft: oklch(0.42 0.012 70);
    --ground: var(--background);
    --crimson: oklch(0.43 0.12 27);
    --slate: oklch(0.38 0.05 245);
    --gold: oklch(0.7 0.1 80);
    --step: oklch(0.27 0.006 270);
    --m: clamp(16px, 2.2vw, 32px);
    --gap: clamp(120px, 14vw, 200px);
    background: var(--ground);
    color: var(--foreground);
    font-family: var(--font-sans);
    overflow-x: clip;
  }
  :global(:root:not(.dark)) .home {
    --ground: oklch(0.88 0.008 85);
    --step: oklch(0.83 0.01 85);
    --paper: oklch(0.985 0.002 90);
  }
  .home a:not(.folder) {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  /* Hero ------------------------------------------------------------------ */
  .hero {
    position: relative;
    min-height: 100svh;
    padding: 18px var(--m) 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .toprow {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    font-size: var(--t-s);
  }
  .toprow-left {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .toprow-right {
    display: flex;
    gap: 22px;
    justify-content: flex-end;
  }
  .toprow-right a {
    text-decoration: none;
  }
  .toprow-right a:hover {
    text-decoration: underline;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-l);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .title {
    margin: clamp(48px, 7vh, 90px) 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(64px, 10vw, 160px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-align: center;
    white-space: nowrap;
  }
  .sub {
    margin: 22px 0 0;
    max-width: 46ch;
    text-align: center;
    font-size: var(--t-l);
    line-height: 1.5;
    color: var(--foreground);
  }
  .folders {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 50%;
    bottom: 0;
  }
  .folder {
    position: absolute;
    left: 0;
    right: 0;
    height: 100%;
    display: block;
    text-decoration: none;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  a.folder:hover,
  a.folder:focus-visible {
    transform: translateY(-10px);
  }
  .folder .tab {
    position: absolute;
    top: -40px;
    height: 40px;
    padding: 0 30px;
    display: flex;
    align-items: center;
    font-size: var(--t-b);
    white-space: nowrap;
    background: inherit;
    clip-path: polygon(14px 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
  }
  .f1 { top: 0; background: var(--gold); color: var(--paper-ink); }
  .f1 .tab { right: 4%; }
  .f2 { top: 48px; background: var(--slate); color: var(--paper); }
  .f2 .tab { right: 30%; }
  .f3 { top: 96px; background: var(--step); color: var(--foreground); }
  .f3 .tab { left: 30%; }
  .f4 { top: 144px; background: var(--crimson); color: var(--paper); }
  .f4 .tab { left: 4%; }
  .front {
    top: 192px;
    background: var(--paper);
    color: var(--paper-ink);
  }
  .front .tab {
    left: 40%;
    font-weight: 600;
  }
  .front-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 24px 48px;
    padding: 32px;
  }
  .front-text { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .plate {
    list-style: none;
    margin: -8px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 8px;
    height: clamp(180px, 22vh, 260px);
  }
  .plate a { display: flex; flex-direction: column; gap: 6px; height: 100%; text-decoration: none; color: var(--paper-soft); font-size: var(--t-s); }
  .plate img { flex: 1; min-height: 0; width: 100%; object-fit: contain; background: oklch(0.97 0.002 90); transition: transform 200ms ease-out; }
  .plate a:hover img { transform: translateY(-4px); }
  .plate a:hover span { color: var(--paper-ink); }
  .action {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 26px;
    background: var(--crimson);
    color: var(--paper) !important;
    font-size: var(--t-b);
    font-weight: 600;
    text-decoration: none;
    clip-path: polygon(10px 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%, 0 10px);
    transition: transform 160ms ease-out, background-color 160ms ease-out;
  }
  .action:hover { background: oklch(0.38 0.12 27); }
  .action:active { transform: translateY(1px); }
  .edition {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--t-b);
    color: var(--paper-soft);
  }
  .edition-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-h);
    color: var(--paper-ink);
  }

  /* Classes --------------------------------------------------------------- */
  .classes {
    display: grid;
    grid-template-columns: minmax(0, 640px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    padding: var(--gap) var(--m) 0;
    max-width: 1440px;
    margin: 0 auto;
  }
  .classes-col {
    container-type: inline-size;
  }
  .giant {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26cqw;
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--crimson);
  }
  :global(.dark) .giant { color: oklch(0.64 0.14 27); }
  .lede {
    margin: 22px 0 22px;
    font-size: var(--t-l);
    line-height: 1.5;
    max-width: 36ch;
  }
  .bars {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .bar {
    background: var(--step);
    transition: opacity 240ms ease-out;
  }
  .bar.is-dim { opacity: 0.55; }
  .bar summary {
    display: grid;
    grid-template-columns: 1fr auto 24px;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 0 18px;
    cursor: pointer;
    list-style: none;
    font-size: var(--t-b);
  }
  .bar summary::-webkit-details-marker { display: none; }
  .bar summary:hover { background: color-mix(in oklch, var(--foreground) 6%, transparent); }
  .bar-name { font-weight: 600; }
  .bar-weapon { color: var(--muted-foreground); font-size: var(--t-b); }
  .bar-plus {
    position: relative;
    width: 16px;
    height: 16px;
  }
  .bar-plus::before,
  .bar-plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 16px;
    height: 2px;
    background: currentColor;
    transition: transform 200ms ease-out;
  }
  .bar-plus::after { transform: rotate(90deg); }
  .bar[open] .bar-plus::after { transform: rotate(0deg); }
  .bar-panel {
    padding: 4px 18px 22px;
    font-size: var(--t-b);
  }
  .bar-panel dl { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .bar-panel dl div { display: grid; grid-template-columns: 6.5em 1fr; gap: 12px; }
  .bar-panel dt { color: var(--muted-foreground); }
  .bar-panel dd { margin: 0; }
  .bar-img { display: none; }
  .preview {
    position: sticky;
